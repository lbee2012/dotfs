
#Wiki for a complete reference! : https://i3wm.org/docs/userguide.html

set $mod Mod1

#System font: Windows' title, Status bar, ... (Not the Terminal font)
font pango:Noto Sans Mono 12

# I3-WM FR
#https://wiki.archlinux.org/index.php/XDG_Autostart
exec --no-startup-id dex --autostart --environment i3
exec --no-startup-id dbus-update-activation-environment --systemd GTK_USE_PORTAL XDG_CURRENT_DESKTOP

#i3status
bar {
    status_command i3status -c ~/.config/i3/status
    position bottom
}



# PERSONAL

set $term kitty
set $files yazi

set $browser firefox
set $notes obsidian
set $study Anki

assign [class=$browser] $ws1
assign [class=$notes] $ws3
assign [class=$study] $ws3

#input_method - ime
exec --no-startup-id fcitx5
#screen_capture - 
bindsym $mod+Shift+s exec xfce4-screenshooter -fc
#clipboard_manager - clipman
exec --no-startup-id xfce4-clipman
bindsym $mod+v exec xfce4-clipman-history
#wallpaper - feh
exec_always --no-startup-id feh --bg-fill ~/git/dots/pics/fam/2008-grandfas.jpg
#application_menu - dmenu
bindsym $mod+space exec dmenu_run -fn "Noto Sans Mono-12"



# SYSTEMD

#restart_i3
bindsym $mod+Shift+r restart
#exit_i3
bindsym $mod+Shift+x exec i3-msg exit
#kill_instance
bindsym $mod+Shift+q kill

#hhkb_layout_laptop
exec_always --no-startup-id /usr/bin/setxkbmap -option "ctrl:swapcaps"
exec_always --no-startup-id xset r rate 250 25

#terminal
bindsym $mod+Return exec $term

#screen_orientations - xrandr
bindsym $mod+Ctrl+Shift+Left exec xrandr -o 1
bindsym $mod+Ctrl+Shift+Down exec xrandr -o 2
bindsym $mod+Ctrl+Shift+Up exec xrandr -o 0
bindsym $mod+Ctrl+Shift+Right exec xrandr -o 3

#outer_margins
gaps outer 1
#inner_paddings
gaps inner 3

#audio - pipewire
set $refresh_i3status killall -SIGUSR1 i3status
bindsym $mod+a exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ -5% && $refresh_i3status
bindsym $mod+s exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ +5% && $refresh_i3status
bindsym $mod+d exec --no-startup-id pactl set-sink-mute @DEFAULT_SINK@ toggle && $refresh_i3status

#layout mode at boot
workspace_layout tabbed
bindsym $mod+f fullscreen toggle

#change_focusing (alt+tab)
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right
#reposition_focused_window
bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right

#workspaces_definition
set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
#workspaces_switching
bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
#transposition_window_to_workspace
bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4

#resize_window
bindsym $mod+Ctrl+Shift+r mode "resize"
mode "resize" {
        bindsym h resize shrink width 5 px or 5 ppt
        bindsym j resize grow height 5 px or 5 ppt
        bindsym k resize shrink height 5 px or 5 ppt
        bindsym l resize grow width 5 px or 5 ppt

        bindsym Return mode "default"
        bindsym Escape mode "default"
        bindsym $mod+r mode "default"
}

